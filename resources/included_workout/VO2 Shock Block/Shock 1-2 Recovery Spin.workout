<?xml version="1.0" encoding="UTF-8"?>
<Workout>
    <Version>2.02</Version>
    <Plan>VO2 Shock Block</Plan>
    <Author>MaximumTrainer</Author>
    <Description>Week 1, Ride 2 - 30 min very easy. Recovery is where the fitness happens.</Description>
    <Type>0</Type>
    <Intervals>
        <Interval>
            <Duration>00:30:00</Duration>
            <DisplayMessage>Recovery - light and smooth</DisplayMessage>
            <TestInterval>0</TestInterval>
            <RepeatIncreaseFTP>0</RepeatIncreaseFTP>
            <RepeatIncreaseCadence>0</RepeatIncreaseCadence>
            <RepeatIncreaseLTHR>0</RepeatIncreaseLTHR>
            <Power>
                <StepType>1</StepType>
                <Start>0.55</Start>
                <End>0.55</End>
                <Range>20</Range>
                <RightBalance>-1</RightBalance>
            </Power>
            <Cadence>
                <StepType>1</StepType>
                <Start>85</Start>
                <End>85</End>
                <Range>10</Range>
            </Cadence>
            <HeartRate>
                <StepType>0</StepType>
                <Start>0.5</Start>
                <End>0.5</End>
                <Range>15</Range>
            </HeartRate>
        </Interval>
    </Intervals>
</Workout>
