<?xml version="1.0" encoding="UTF-8"?>
<Workout>
    <Version>2.02</Version>
    <Plan>Base Camp</Plan>
    <Author>MaximumTrainer</Author>
    <Description>Week 1, Ride 1 - 40 min easy. Nothing fancy: just you, the bike, and a steady zone 2.</Description>
    <Type>0</Type>
    <Intervals>
        <Interval>
