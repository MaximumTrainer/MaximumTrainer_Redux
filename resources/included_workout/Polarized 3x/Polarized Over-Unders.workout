<?xml version="1.0" encoding="UTF-8"?>
<Workout>
    <Version>2.02</Version>
    <Plan>Polarized 3x</Plan>
    <Author>Robin Ingelbrecht</Author>
    <Description>2 sets of 6x (1 min over at 110% / 1 min under at 88%). Lactate clearance and threshold durability. Adapted from Robin Ingelbrecht's 80/20 polarized Zwift workouts (MIT license).</Description>
    <Type>5</Type>
    <Intervals>
        <Interval>
            <Duration>00:10:00</Duration>
            <DisplayMessage>Warm up</DisplayMessage>
            <TestInterval>0</TestInterval>
            <RepeatIncreaseFTP>0</RepeatIncreaseFTP>
            <RepeatIncreaseCadence>0</RepeatIncreaseCadence>
            <RepeatIncreaseLTHR>0</RepeatIncreaseLTHR>
            <Power>
                <StepType>2</StepType>
                <Start>0.6</Start>
                <End>0.85</End>
                <Range>20</Range>
                <RightBalance>-1</RightBalance>
            </Power>
            <Cadence>
                <StepType>1</StepType>
                <Start>90</Start>
                <End>90</End>
                <Range>10</Range>
            </Cadence>
            <HeartRate>
                <StepType>0</StepType>
                <Start>0.5</Start>
                <End>0.5</End>
                <Range>15</Range>
            </HeartRate>
        </Interval>
        <Interval>
            <Duration>00:01:30</Duration>
