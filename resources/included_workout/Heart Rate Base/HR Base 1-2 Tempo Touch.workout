<?xml version="1.0" encoding="UTF-8"?>
<Workout>
    <Version>2.02</Version>
    <Plan>Heart Rate Base</Plan>
    <Author>MaximumTrainer</Author>
    <Description>Week 1, Ride 2 - 3x6 min at tempo heart rate (92% LTHR) with easy valleys.</Description>
    <Type>2</Type>
    <Intervals>
        <Interval>
            <Duration>00:08:00</Duration>
            <DisplayMessage>Warm up</DisplayMessage>
            <TestInterval>0</TestInterval>
            <RepeatIncreaseFTP>0</RepeatIncreaseFTP>
            <RepeatIncreaseCadence>0</RepeatIncreaseCadence>
            <RepeatIncreaseLTHR>0</RepeatIncreaseLTHR>
            <Power>
                <StepType>0</StepType>
                <Start>0</Start>
                <End>0</End>
                <Range>20</Range>
                <RightBalance>-1</RightBalance>
            </Power>
            <Cadence>
                <StepType>1</StepType>
                <Start>85</Start>
                <End>85</End>
                <Range>10</Range>
            </Cadence>
            <HeartRate>
                <StepType>2</StepType>
                <Start>0.7</Start>
                <End>0.85</End>
                <Range>8</Range>
            </HeartRate>
        </Interval>
        <Interval>
            <Duration>00:06:00</Duration>
            <DisplayMessage>Tempo - 92% LTHR</DisplayMessage>
            <TestInterval>0</TestInterval>
            <RepeatIncreaseFTP>0</RepeatIncreaseFTP>
            <RepeatIncreaseCadence>0</RepeatIncreaseCadence>
            <RepeatIncreaseLTHR>0</RepeatIncreaseLTHR>
            <Power>
                <StepType>0</StepType>
                <Start>0</Start>
                <End>0</End>
                <Range>20</Range>
                <RightBalance>-1</RightBalance>
            </Power>
            <Cadence>
                <StepType>1</StepType>
                <Start>90</Start>
                <End>90</End>
                <Range>10</Range>
            </Cadence>
            <HeartRate>
                <StepType>1</StepType>
                <Start>0.92</Start>
                <End>0.92</End>
                <Range>5</Range>
            </HeartRate>
        </Interval>
        <Interval>
            <Duration>00:04:00</Duration>
            <DisplayMessage>Easy - let it drop</DisplayMessage>
            <TestInterval>0</TestInterval>
            <RepeatIncreaseFTP>0</RepeatIncreaseFTP>
            <RepeatIncreaseCadence>0</RepeatIncreaseCadence>
            <RepeatIncreaseLTHR>0</RepeatIncreaseLTHR>
            <Power>
                <StepType>0</StepType>
                <Start>0</Start>
                <End>0</End>
                <Range>20</Range>
                <RightBalance>-1</RightBalance>
            </Power>
            <Cadence>
                <StepType>1</StepType>
                <Start>85</Start>
                <End>85</End>
                <Range>10</Range>
            </Cadence>
            <HeartRate>
                <StepType>1</StepType>
                <Start>0.82</Start>
                <End>0.82</End>
                <Range>5</Range>
            </HeartRate>
        </Interval>
        <Interval>
            <Duration>00:07:00</Duration>
            <DisplayMessage>Cool down</DisplayMessage>
            <TestInterval>0</TestInterval>
            <RepeatIncreaseFTP>0</RepeatIncreaseFTP>
            <RepeatIncreaseCadence>0</RepeatIncreaseCadence>
            <RepeatIncreaseLTHR>0</RepeatIncreaseLTHR>
            <Power>
                <StepType>0</StepType>
                <Start>0</Start>
                <End>0</End>
                <Range>20</Range>
                <RightBalance>-1</RightBalance>
            </Power>
            <Cadence>
                <StepType>1</StepType>
                <Start>85</Start>
                <End>85</End>
                <Range>10</Range>
            </Cadence>
            <HeartRate>
                <StepType>1</StepType>
                <Start>0.75</Start>
                <End>0.75</End>
                <Range>8</Range>
            </HeartRate>
        </Interval>
    </Intervals>
    <Repeats>
        <Repeat>
            <Id>0</Id>
            <FirstRow>1</FirstRow>
            <LastRow>2</LastRow>
            <NumberRepeat>3</NumberRepeat>
        </Repeat>
    </Repeats>
</Workout>
