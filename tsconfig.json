{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": ".playwright-ts-out"
  },
  "include": [
    "playwright.config.ts",
    "tests/playwright/**/*.ts"
  ]
}
