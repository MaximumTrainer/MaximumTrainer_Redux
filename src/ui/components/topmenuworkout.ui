  <property name="styleSheet">
   <string notr="true">/* Background color */
QFrame#frame_menu {
        background-color: rgb(0, 0, 0);
}

/* This toolbar is part of the always-dark workout view. Reset buttons to a
   flat, borderless look so the application dark theme's generic
   QPushButton/QToolButton styling (background + border) does not draw boxes
   around the icon-only controls. The per-id image rules below still apply. */
QPushButton, QToolButton {
        background-color: transparent;
        border: none;
        color: white;
}

/* Give the icon-only radio buttons a slightly larger, evenly padded hit area
   so they are easier to click. */
QToolButton {
        padding: 3px;
}

/* Hover highlight: make it obvious which icon-only control is under the cursor
   and where the clickable area is. */
QToolButton:hover,
QPushButton#pushButton_config:hover,
QPushButton#pushButton_expand:hover,
QPushButton#pushButton_exit:hover {
        background-color: #3c3c3c;
        border-radius: 4px;
}

/* Start / Interval are real text buttons, not icon-only controls, so give them
   a standard, native-looking button chrome (the flat reset above is meant for
   the icon-only window/radio controls). */
QPushButton#pushButton_start, QPushButton#pushButton_lap {
        background-color: #2d2d2d;
        border: 1px solid #5a5a5a;
        border-radius: 6px;
        padding: 4px 14px;
        color: white;
        font-weight: 600;
}
/* Start is the primary action — give it the accent. */
QPushButton#pushButton_start {
        background-color: #2e5235;
        border-color: #4f8f5e;
}
QPushButton#pushButton_start:hover {
        background-color: #38663f;
        border-color: #63a973;
}
QPushButton#pushButton_lap:hover {
        background-color: #3c3c3c;
        border-color: #6e6e6e;
}
QPushButton#pushButton_start:pressed, QPushButton#pushButton_lap:pressed {
        background-color: #555555;
}

QGroupBox#groupBox_commandWorkout {
     border: 1px solid #4a4a4a;
     border-radius: 6px;
     background-color: rgb(0, 0, 0);
margin-top:-6px;
}
QGroupBox::title {
    margin:0px;
	padding: 0px;
}

/* Radio controls: a light border visually groups the radio icon with its
   prev/play-pause/next buttons. The button reset above keeps the buttons
   themselves borderless so only this frame draws an outline. */
QFrame#frame_radioGroup {
	border: 1px solid rgb(120, 120, 120);
	border-radius: 4px;
}

QLabel {
color:white;
}

/* Timer hierarchy: elapsed/remaining are the heroes, the title and clock
   sit quietly beside them. */
#label_timeElapsed, #label_remainingTime {
	color: #ffa726;
	font-weight: 600;
}
#label_intervalTime {
	color: rgb(89, 171, 121);
	font-weight: 600;
}
#label_nameWorkout {
	font-weight: 600;
}
#label_currentTime, #label_dash1 {
	color: #9a9a9a;
}


